  <link rel="prefetch" href="https://cdn.shopify.com/extensions/01a01942-2b81-717a-af64-b9be9c6e1774/gdpr-backpack-844/assets/layout-cookie-smart-banner.consentmo.js" crossorigin data-csm-layout-prefetch="smart">
