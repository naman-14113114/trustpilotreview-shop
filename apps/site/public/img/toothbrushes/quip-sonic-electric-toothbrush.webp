      shoplift.isHypothesisActive('019b933e-2ed8-70aa-b0b4-13dccfed4743'), // Tabbed Recs
      shoplift.isHypothesisActive('019cae41-ed40-7462-8ca7-502e649183a6'), // PLP price range message
      shoplift.isHypothesisActive('019c9fc9-243f-72d6-8c9e-1fa0c21840f2'), // Nav reorder - new visitors
      shoplift.isHypothesisActive('019c9fd4-73ae-7d17-a5d8-2aa07c12785e'), // Nav reorder - returning visitors
    ]);

    if (isTabbedRecsActive) {
      document.body.classList.add('shoplift-tabbed-recs-active');
    }
    if (isPLPPriceRangeMessageActive) {
      document.body.classList.add('shoplift-plp-price-range-message-active');
