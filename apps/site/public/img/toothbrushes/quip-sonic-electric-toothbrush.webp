<script>
  (() => {
    const initGorgiasChatPromise = window.GorgiasChat
      ? window.GorgiasChat.init()
      : new Promise((resolve) => {
          window.addEventListener('gorgias-widget-loaded', () => resolve());
        });

    initGorgiasChatPromise.then(() => {
      GorgiasChat.on('widget:opened', () => {
        document.body.classList.add('gorgias-chat-opened');
      });
      GorgiasChat.on('widget:closed', () => {
        document.body.classList.remove('gorgias-chat-opened');
      });
    });

    document.addEventListener('rebuy:smartcart.show', (event) => GorgiasChat?.close && GorgiasChat.close());
  })();
</script>


    

