    if (isNavReorderNewVisitors) {
      document.body.classList.add('shoplift-nav-reorder-new-visitors-active');
    }

    if (isNavReorderReturningVisitors) {
      document.body.classList.add('shoplift-nav-reorder-returning-visitors-active');
    }
  });
</script>

<!-- Shoplift Tests (metaobject-driven) -->
<script>
  (async () => {
    const tests = [{
          api_id: "123cvc123123-1231dfhded3",
          name: "Dummy AB Test",
          handle: "dummy-ab-test"
        }];

    const testResults = await Promise.all(
      tests.map(test => shoplift.isHypothesisActive(test.api_id))
    );

    const testResultsMap = tests.reduce((acc, test, index) => {
      acc[test.handle] = testResults[index];
      return acc;
    }, {});

    window.shopliftTests = testResultsMap;

    Object.entries(testResultsMap).forEach(([handle, isActive]) => {
      if (isActive) {
        document.body.classList.add(handle);
        document.dispatchEvent(
          new CustomEvent("shoplift-test-active", {
            detail: handle
          })
        );
      }
    });
  })();
</script>
