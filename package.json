{
  "name": "trustpilotreview-shop-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:site": "pnpm --filter @trustpilotreview/site dev",
    "build": "turbo build",
    "build:site": "pnpm --filter @trustpilotreview/site build",
    "start:site": "pnpm --filter @trustpilotreview/site start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify:parity": "pnpm --filter @trustpilotreview/site verify:parity"
  },
  "devDependencies": {
    "turbo": "^2.8.6",
    "typescript": "5.9.3"
  }
}
